{
  "name": "gym-saas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "next dev",
    "build": "SUPPRESS_BASELINE_WARNINGS=true next build 2>&1 | grep -v 'baseline-browser-mapping'",
    "start": "next start",
    "lint": "eslint",
    "pages:build": "pnpm dlx @cloudflare/next-on-pages",
    "pages:preview": "pnpm run pages:build && wrangler pages dev --compatibility-flag=nodejs_compat --env-file=.env.local",
    "pages:deploy": "pnpm run pages:build && wrangler pages deploy",
    "db:create": "wrangler d1 create gym-saas-db",
    "db:migrate": "wrangler d1 execute gym-saas-db --file=d1-schema.sql",
    "db:migrate:local": "wrangler d1 execute gym-saas-db --local --file=d1-schema.sql",
    "db:migrate:status": "wrangler d1 execute gym-saas-db --remote --file=migrations/001_gym_status.sql",
    "db:migrate:status:local": "wrangler d1 execute gym-saas-db --local --file=migrations/001_gym_status.sql"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.3",
    "@clerk/themes": "^2.4.40",
    "@supabase/supabase-js": "^2.86.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.555.0",
    "next": "15.5.15",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@cloudflare/workers-types": "^4.20260503.1",
    "@next/eslint-plugin-next": "15.5.15",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.9.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.15",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.87.0"
  }
}